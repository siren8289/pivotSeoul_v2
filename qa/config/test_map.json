{
  "version": 3,
  "areas": {
    "01_unit_integration": {
      "tool_a_class": "unit_runner",
      "tool_b_class": "integration_or_blackbox",
      "note_ko": "Python은 pytest, DB 비의존 단위 로직에 Testcontainers를 강제하지 않음. 2차는 독립 불변/계약 검증."
    },
    "02_web_api": {
      "tool_a_class": "ui_or_contract_runner",
      "tool_b_class": "openapi_or_http_contract",
      "note_ko": "목표 도구는 Playwright + Schemathesis. 현재 프론트는 node --test/E2E 루프백, API는 pytest 계약 + OpenAPI 스키마 검증. Playwright 미연결은 RISK."
    },
    "03_security_quality": {
      "tool_a_class": "semgrep_or_secret_scan",
      "tool_b_class": "codeql_or_independent_grep",
      "note_ko": "Semgrep은 로컬/CI. CodeQL은 GitHub codeql job. 비밀값·인증 표면은 별도 이중 패턴 검증 유지."
    },
    "04_infra_deploy": {
      "tool_a_class": "compose_static_and_health",
      "tool_b_class": "http_smoke_or_compose_grep",
      "note_ko": "필수 게이트는 compose 정적 이중 검증. curl 스모크는 서비스 기동 시/회귀 프로파일. k6는 스테이징 전용."
    }
  },
